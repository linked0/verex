# Verex web (Next.js) env 템플릿. 실제 값은 .env.local 에 (gitignore 처리됨, 커밋 금지).

# === v1 (read-only 마켓 표시)에서 필요한 것 ===
# Verex API(packages/api)의 베이스 URL. 브라우저에 노출되므로 NEXT_PUBLIC_ 접두사가 "정상"
# (URL이지 비밀이 아님).
#   로컬: http://localhost:4000
#   운영: https://<verex-api Cloud Run URL>
NEXT_PUBLIC_API_URL=

# === Auth.js (Google 로그인) — v1에서는 미사용 (홈은 공개; 로그인은 매매 기능 추가 시점에) ===
# ⚠️ 아래는 서버 전용 비밀 — NEXT_PUBLIC_ 접두사 절대 금지.

# 1) 세션 암호화 시크릿 — 생성: `npx auth secret`  또는  `openssl rand -base64 32`
AUTH_SECRET=

# 2) Google OAuth 클라이언트 (Google Cloud Console > APIs & Services > Credentials)
#    Authorized redirect URI:
#      로컬:  http://localhost:3000/api/auth/callback/google
#      운영:  https://<배포도메인>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 3) 콜백 베이스 URL — 운영/cloud 전용 (예: https://<배포도메인>)
#    로컬은 비워둬도 Auth.js가 자동 추론.
AUTH_URL=
