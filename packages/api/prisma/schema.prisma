// Verex — prediction market backed by real CTF contracts on anvil (v2).
// Markets are binary (Yes/No) CTF conditions; the DB mirrors chain state for
// fast reads and holds display-only data (category, copy, price history).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MarketStatus {
  OPEN
  RESOLVED
  CANCELLED
}

enum TradeSide {
  BUY
  SELL
  REDEEM // post-resolution redemption — recorded so portfolio history shows realized P&L
}

enum GroupStatus {
  CREATING // batch creation in flight — hidden from the homepage until OPEN
  OPEN
  RESOLVED
  CANCELLED
}

/// A multi-outcome market ("Who wins the World Cup?") — N mutually exclusive
/// member Markets, each its own binary CTF condition (the CTFExchange registry
/// is structurally binary, so N-ary trades as N grouped binaries; see
/// docs/tasks/jul-28-verex-design.md A.1). DB-only: groups have no chain
/// identity of their own.
model MarketGroup {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String // "Who will win the 2026 World Series?"
  description String?
  category    String
  imageUrl    String?
  status      GroupStatus @default(OPEN)
  closesAt    DateTime?
  resolvedMarketId String? // winning member market once RESOLVED
  creator     String? // wallet address that created it (null = seeded)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  markets     Market[]

  @@index([category, status])
}

/// Deployed contract addresses for the chain this DB mirrors. Single row
/// (id=1) written by the seed script — the API reads it at startup so no
/// env-var coordination is needed between seed and server.
model ChainConfig {
  id           Int    @id @default(1)
  chainId      Int
  rpcUrl       String
  usdcAddr     String
  ctfAddr      String
  exchangeAddr String
  operator     String // account 0 — oracle, exchange operator, MM inventory
}

/// A binary prediction market backed by an on-chain CTF condition.
model Market {
  id                String       @id @default(cuid())
  slug              String       @unique
  title             String
  description       String?
  category          String // "Politics" | "Sports" | "Crypto" | "Economics" | "Tech & Science" | "Climate" | "Culture"
  imageUrl          String?
  status            MarketStatus @default(OPEN)
  volume            Decimal      @default(0) @db.Decimal(20, 2)
  closesAt          DateTime?
  resolvedOutcomeId String? // which outcome won, once RESOLVED
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // On-chain identity (set at seed time; hex strings / uint256 decimal strings)
  questionId  String @unique // keccak256 of the question text
  conditionId String @unique
  yesTokenId  String // ERC-1155 position id (uint256 as decimal string)
  noTokenId   String

  // Group membership (null = standalone binary market). Inside a group the
  // market's `title` stays the full legal question; `groupLabel` is the short
  // outcome chip ("Brazil").
  groupId    String?
  group      MarketGroup? @relation(fields: [groupId], references: [id])
  groupLabel String?
  sortOrder  Int          @default(0)
  creator    String? // wallet address that created it (null = seeded)

  outcomes    Outcome[]
  trades      Trade[]
  pricePoints PricePoint[]
  orders      Order[]

  @@index([category, status])
}

/// One side of a binary market. `price` is the YES-implied probability for
/// the Yes row and (1 - yesPrice) for the No row — kept denormalized so the
/// UI reads one shape for both.
model Outcome {
  id        String  @id @default(cuid())
  marketId  String
  market    Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  label     String // "Yes" | "No"
  price     Decimal @db.Decimal(10, 6) // implied probability, 0..1
  tokenId   String // ERC-1155 position id backing this outcome
  sortOrder Int     @default(0)
  trades    Trade[]
  orders    Order[]

  @@index([marketId])
}

/// How far a trade's on-chain settlement has progressed. Fills happen
/// instantly in the DB book; the chain follows via the ChainJob worker.
enum SettlementStatus {
  PENDING
  CONFIRMED
  FAILED // terminally failed after retries — the fill was compensated (reversed)
}

/// A fill. One row per matched pair per user side (taker always; maker too
/// when the maker is a demo user rather than the operator MM). `txHash` is
/// null until the ChainJob worker settles the match on-chain.
model Trade {
  id          String    @id @default(cuid())
  marketId    String
  market      Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  outcomeId   String
  outcome     Outcome   @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  user        String // trader address (demo anvil account)
  side        TradeSide
  usdcAmount  Decimal   @db.Decimal(20, 6) // collateral paid/received
  tokenAmount Decimal   @db.Decimal(20, 6) // outcome tokens received/sold
  price       Decimal   @db.Decimal(10, 6) // executed price (USDC per token)
  txHash      String?
  settlement  SettlementStatus @default(CONFIRMED)
  /// Book fills: which orders produced this row (no FK — keep deletes simple).
  takerOrderId String?
  makerOrderId String?
  createdAt   DateTime  @default(now())

  @@index([marketId, createdAt])
  @@index([user])
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  EXPIRED
}

/// A limit order in the off-chain book. Matching is price-time priority and
/// happens in the DB; matched pairs settle on-chain asynchronously via
/// CTFExchange.matchOrders (SETTLE_MATCH ChainJob). `signedOrder` holds the
/// full EIP-712 order (bigints as strings) for resting orders — they act as
/// makers when a later order crosses them. IOC (market) taker orders are
/// signed at settlement time instead and never rest, so theirs is null.
model Order {
  id          String      @id @default(cuid())
  marketId    String
  market      Market      @relation(fields: [marketId], references: [id], onDelete: Cascade)
  outcomeId   String
  outcome     Outcome     @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  maker       String // wallet address
  makerIndex  Int // demo wallet index (0 = operator MM)
  side        OrderSide
  price       Decimal     @db.Decimal(10, 6) // USDC per share, 0.01..0.99
  size        Decimal     @db.Decimal(20, 6) // outcome tokens
  sizeFilled  Decimal     @default(0) @db.Decimal(20, 6)
  status      OrderStatus @default(OPEN)
  isMM        Boolean     @default(false) // operator ladder order, managed by re-quotes
  signedOrder Json?
  orderHash   String?     @unique
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([outcomeId, status, side, price, createdAt])
  @@index([maker, status])
}

enum ChainJobType {
  SETTLE_MATCH // settle matched order pairs via CTFExchange.matchOrders
  RESOLVE // reportPayouts for a market (or every member of a group)
  REDEEM // redeemPositions for a user in a resolved market
  CREATE_GROUP // batch-create a market group's on-chain backbone
}

enum ChainJobStatus {
  PENDING
  RUNNING
  CONFIRMED
  FAILED
}

/// Queued on-chain work. The API responds from the DB immediately and a
/// single in-process worker executes these strictly serially — every tx is
/// sent by the operator or a server-held demo key, so serial execution
/// doubles as nonce management.
model ChainJob {
  id          String         @id @default(cuid())
  type        ChainJobType
  status      ChainJobStatus @default(PENDING)
  payload     Json
  result      Json? // {txHashes: []} on success / error detail on failure
  attempts    Int            @default(0)
  maxAttempts Int            @default(3)
  runAfter    DateTime       @default(now()) // backoff scheduling
  claimedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, runAfter])
}

/// YES-price history for charts. Seeded with synthetic history, appended on
/// every trade.
model PricePoint {
  id       String   @id @default(cuid())
  marketId String
  market   Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  price    Decimal  @db.Decimal(10, 6) // YES implied probability
  at       DateTime @default(now())

  @@index([marketId, at])
}
