// Verex — prediction market backed by real CTF contracts on anvil (v2).
// Markets are binary (Yes/No) CTF conditions; the DB mirrors chain state for
// fast reads and holds display-only data (category, copy, price history).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MarketStatus {
  OPEN
  RESOLVED
  CANCELLED
}

enum TradeSide {
  BUY
  SELL
  REDEEM // post-resolution redemption — recorded so portfolio history shows realized P&L
}

enum GroupStatus {
  CREATING // batch creation in flight — hidden from the homepage until OPEN
  OPEN
  RESOLVED
  CANCELLED
}

/// A multi-outcome market ("Who wins the World Cup?") — N mutually exclusive
/// member Markets, each its own binary CTF condition (the CTFExchange registry
/// is structurally binary, so N-ary trades as N grouped binaries; see
/// docs/tasks/jul-28-verex-design.md A.1). DB-only: groups have no chain
/// identity of their own.
model MarketGroup {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String // "Who will win the 2026 World Series?"
  description String?
  category    String
  imageUrl    String?
  status      GroupStatus @default(OPEN)
  closesAt    DateTime?
  resolvedMarketId String? // winning member market once RESOLVED
  creator     String? // wallet address that created it (null = seeded)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  markets     Market[]

  @@index([category, status])
}

/// Deployed contract addresses for the chain this DB mirrors. Single row
/// (id=1) written by the seed script — the API reads it at startup so no
/// env-var coordination is needed between seed and server.
model ChainConfig {
  id           Int    @id @default(1)
  chainId      Int
  rpcUrl       String
  usdcAddr     String
  ctfAddr      String
  exchangeAddr String
  operator     String // account 0 — oracle, exchange operator, MM inventory
}

/// A binary prediction market backed by an on-chain CTF condition.
model Market {
  id                String       @id @default(cuid())
  slug              String       @unique
  title             String
  description       String?
  category          String // "Politics" | "Sports" | "Crypto" | "Economics" | "Tech & Science" | "Climate" | "Culture"
  imageUrl          String?
  status            MarketStatus @default(OPEN)
  volume            Decimal      @default(0) @db.Decimal(20, 2)
  closesAt          DateTime?
  resolvedOutcomeId String? // which outcome won, once RESOLVED
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // On-chain identity (set at seed time; hex strings / uint256 decimal strings)
  questionId  String @unique // keccak256 of the question text
  conditionId String @unique
  yesTokenId  String // ERC-1155 position id (uint256 as decimal string)
  noTokenId   String

  // Group membership (null = standalone binary market). Inside a group the
  // market's `title` stays the full legal question; `groupLabel` is the short
  // outcome chip ("Brazil").
  groupId    String?
  group      MarketGroup? @relation(fields: [groupId], references: [id])
  groupLabel String?
  sortOrder  Int          @default(0)
  creator    String? // wallet address that created it (null = seeded)

  outcomes    Outcome[]
  trades      Trade[]
  pricePoints PricePoint[]

  @@index([category, status])
}

/// One side of a binary market. `price` is the YES-implied probability for
/// the Yes row and (1 - yesPrice) for the No row — kept denormalized so the
/// UI reads one shape for both.
model Outcome {
  id        String  @id @default(cuid())
  marketId  String
  market    Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  label     String // "Yes" | "No"
  price     Decimal @db.Decimal(10, 6) // implied probability, 0..1
  tokenId   String // ERC-1155 position id backing this outcome
  sortOrder Int     @default(0)
  trades    Trade[]

  @@index([marketId])
}

/// A real on-chain fill (CTFExchange.fillOrder). One row per trade.
model Trade {
  id          String    @id @default(cuid())
  marketId    String
  market      Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  outcomeId   String
  outcome     Outcome   @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  user        String // trader address (demo anvil account)
  side        TradeSide
  usdcAmount  Decimal   @db.Decimal(20, 6) // collateral paid/received
  tokenAmount Decimal   @db.Decimal(20, 6) // outcome tokens received/sold
  price       Decimal   @db.Decimal(10, 6) // executed price (USDC per token)
  txHash      String
  createdAt   DateTime  @default(now())

  @@index([marketId, createdAt])
  @@index([user])
}

/// YES-price history for charts. Seeded with synthetic history, appended on
/// every trade.
model PricePoint {
  id       String   @id @default(cuid())
  marketId String
  market   Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  price    Decimal  @db.Decimal(10, 6) // YES implied probability
  at       DateTime @default(now())

  @@index([marketId, at])
}
