# packages/api (Fastify) env template. Real values → packages/api/.env (git-ignored).

# DATABASE_URL — Postgres connection.
#   You do NOT need to provide this for deploy: I generate it when I create the Cloud SQL
#   instance, and push it to Secret Manager for production. Shown here so you know what the
#   API reads. (For local dev, point it at a local/Cloud SQL Postgres.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/verex

# PORT — Cloud Run sets this automatically; only matters for local dev.
PORT=4000
