# packages/api (Fastify) env template. Real values → packages/api/.env (git-ignored).
#
# For LOCAL DEV, this file works as-is: only DATABASE_URL (and optionally PORT)
# is needed. Every chain variable below stays unset on purpose, so the API and
# the seed target local anvil via their built-in defaults.

# DATABASE_URL — Postgres connection.
#   Local dev: the throwaway Docker Postgres from scripts/dev-local.sh →
#   postgresql://postgres:dev@localhost:5432/verex
#   Cloud: never set here — deploy.sh generates it per environment and Cloud
#   Run receives it from Secret Manager.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/verex

# PORT — Cloud Run sets this automatically; only matters for local dev.
PORT=4000

# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID — optional. When both are set, the API
# sends a Telegram message on trade/faucet/resolve events (fire-and-forget,
# never blocks a request). Unset = notifications are simply off.
#   Local dev: get the token from @BotFather, and the chat id by messaging
#   your bot once then checking https://api.telegram.org/bot<TOKEN>/getUpdates.
#   Cloud: never set here — deploy.sh pulls TELEGRAM_BOT_TOKEN from
#   Secret Manager (verex-telegram-bot-token-<db-name>), same pattern as
#   DATABASE_URL. Set TELEGRAM_CHAT_ID in scripts/deploy.env(.prod) instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# VEREX_OPERATOR_KEY — the private key the API signs operator actions with
# (faucet mints, MM inventory, operator resolution). Account 0.
#
# Leave it UNSET for local anvil. Unset means account 0 is derived from the
# demo mnemonic, which is exactly the account scripts/dev-local.sh seeds with —
# so the API and the seeded chain agree by construction. Setting it to anything
# else silently breaks every operator action: the key that seeded the chain
# holds the gas, and a different account holds none, so the tx dies as
# "Insufficient funds for gas * price + value" with nothing naming the sender.
# (2026-08-27 — this is not hypothetical, it cost an afternoon.)
#
#   Cloud: set per environment via deploy.sh / Secret Manager, matching the key
#   that ran the deploy + seed for that environment.
#VEREX_OPERATOR_KEY=

# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET — the funding leg (Stripe Checkout
# → internal USDCX ledger; POST /funding/checkout + POST /webhooks/stripe).
# TEST-mode keys ONLY (sk_test_… / whsec_…) — the API refuses anything else by
# prefix, because a live key would move real money into a play-money ledger.
# Unset = the funding endpoints answer 503 and the rest of the API works as
# before.
#   Keys: Stripe Dashboard → Developers → API keys (test mode).
#   Local webhooks: stripe listen --forward-to localhost:4000/webhooks/stripe
#   (it prints the whsec_… to use here).
#   Test card: 4242 4242 4242 4242, any future expiry, any CVC.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# VEREX_WEB_URL — where Stripe Checkout sends the browser back after payment
# (the success/cancel URLs point at the web app's /funding page). Local dev
# default below; on the cloud, the deployed web origin.
VEREX_WEB_URL=http://localhost:3000
