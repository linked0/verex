# packages/api (Fastify) env template. Real values → packages/api/.env (git-ignored).

# DATABASE_URL — Postgres connection.
#   You do NOT need to provide this for deploy: I generate it when I create the Cloud SQL
#   instance, and push it to Secret Manager for production. Shown here so you know what the
#   API reads. (For local dev, point it at a local/Cloud SQL Postgres.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/verex

# PORT — Cloud Run sets this automatically; only matters for local dev.
PORT=4000

# --- Chain config — all optional for local dev (anvil is the default) ---
#
# VEREX_RPC_URL — defaults to local anvil (http://127.0.0.1:8545). Set to a
#   real testnet RPC (e.g. an Alchemy/Infura Base Sepolia URL) to run against
#   a real chain. Treat this as a credential once it embeds an API key —
#   Secret Manager in the cloud, never committed.
VEREX_RPC_URL=http://127.0.0.1:8545

# VEREX_CHAIN_ID — defaults to 31337 (anvil). Set to 11155111 for Ethereum
#   Sepolia, or 84532 for Base Sepolia (see CHAINS in packages/sdk/src/chain.ts
#   for the full supported list).
VEREX_CHAIN_ID=31337

# VEREX_OPERATOR_KEY — required on any real chain. MUST be the exact
#   same key used to `forge script --broadcast` the contracts (whoever
#   deploys becomes the CTF Exchange's permanent admin/operator) — a
#   mismatch means every operator-signed call (fillOrder, reportPayouts,
#   registerToken, faucet mint) reverts forever. Unset → falls back to a
#   mnemonic-derived local dev account (anvil only). Never commit a real
#   value here.
VEREX_OPERATOR_KEY=

# VEREX_DEMO_MNEMONIC — required on any real chain (VEREX_CHAIN_ID != 31337).
#   Must be a FRESH, private mnemonic nobody else knows — do not reuse
#   anvil's default ("test test test ... junk"), it's public and anyone
#   could derive the same demo-wallet keys on a real chain. Unset → falls
#   back to anvil's default mnemonic (anvil only; the API refuses to start
#   deriving demo-wallet accounts without this on a real chain).
VEREX_DEMO_MNEMONIC=
