{
  "name": "@verex/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "migrate": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "check-deployment": "tsx scripts/check-deployment.ts",
    "save-deployment": "tsx scripts/save-deployment.ts",
    "save-uma-adapter": "tsx scripts/save-uma-adapter.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@prisma/client": "^5.18.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "@verex/sdk": "workspace:*",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prisma": "^5.18.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}