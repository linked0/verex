# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
out/
.next/
cache/

# Next.js auto-generated (regenerated on every build — should not be committed)
next-env.d.ts
*.tsbuildinfo

# Foundry
packages/contracts/out/
packages/contracts/cache/
packages/contracts/broadcast/

# Environment — deny every .env variant, then re-allow the committed templates.
# (Listing variants one by one let `.env.staging` slip through: real operator
# keys sitting one `git add -A` away from a public repo.)
.env
.env.*
!.env.example
!.env.*.example
scripts/deploy.env
scripts/deploy.env.*
!scripts/deploy.env.example

# Cloud SQL Auth Proxy binary (downloaded by deploy.sh)
cloud-sql-proxy

# Turbo
.turbo/

# Auto-generated ABIs (regenerate via `pnpm --filter @verex/sdk sync-abis`)
packages/sdk/src/abis/

# Misc
.DS_Store
*.log

# Claude Code personal settings
.claude/settings.local.json
scripts/deploy.env.prod

# firebase CLI local deploy cache
.firebase/
