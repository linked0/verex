# verex/scripts/deploy.sh config — copy to scripts/deploy.env and fill in (git-ignored).
#
# 👉 The ONLY value you must provide for deploy: PROJECT_ID (your Verex GCP project's ID).
#    Find it in the Cloud Console project picker — use the "ID" (e.g. verex-123456),
#    NOT the display name "Verex". (Name ≠ ID.)
PROJECT_ID=your-verex-gcp-project-id
REGION=asia-northeast3

# Environment: staging (default below) or production.
# Staging = *-staging services + verex_staging DB + staging.verex.jaylabs.xyz.
SERVICE_WEB=verex-web-staging
SERVICE_API=verex-api-staging
DB_NAME=verex_staging
DOMAIN=staging.verex.jaylabs.xyz

# Production values (switch when going live):
#   SERVICE_WEB=verex-web  SERVICE_API=verex-api  DB_NAME=verex  DOMAIN=verex.jaylabs.xyz
# Both environments share one Cloud SQL instance (DB_INSTANCE) to keep cost single.
DB_INSTANCE=verex-db

# VEREX_CHAIN_ID — unset (default) = today's behavior: markets browse fine, trading
#   disabled (DB-only seed). Set to a real chain id to go live — 11155111 for Ethereum
#   Sepolia, 84532 for Base Sepolia (see CHAINS in packages/sdk/src/chain.ts for the
#   full supported list) — requires three Secret Manager secrets to already exist
#   first (verex-rpc-url-<DB_NAME>, verex-operator-key-<DB_NAME>,
#   verex-demo-mnemonic-<DB_NAME>); see docs/runbooks/contracts-testnet-deploy.md for exact
#   creation commands. deploy.sh reads these, it never creates or prints them.
VEREX_CHAIN_ID=
