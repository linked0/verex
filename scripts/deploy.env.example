# verex/scripts/deploy.sh config — copy to scripts/deploy.env and fill in (git-ignored).
#
# 👉 The ONLY value you must provide for deploy: PROJECT_ID (your Verex GCP project's ID).
#    Find it in the Cloud Console project picker — use the "ID" (e.g. verex-123456),
#    NOT the display name "Verex". (Name ≠ ID.)
PROJECT_ID=your-verex-gcp-project-id
REGION=asia-northeast3

# TEST environment (this file): the verex-web/verex-api services, reachable at their
# *.run.app URLs only — no custom domain. PRODUCTION lives in its own file,
# scripts/deploy.env.prod (verex-*-prod services, its OWN Cloud SQL instance,
# verex.jaylabs.xyz), deployed via ./scripts/deploy-prod.sh. Each environment gets its
# own Cloud SQL INSTANCE — full isolation, nothing shared but the GCP project.
SERVICE_WEB=verex-web
SERVICE_API=verex-api
DB_NAME=verex
DB_INSTANCE=verex-db
DOMAIN=

# VEREX_CHAIN_ID — unset (default) = DB-only deploy: markets browse fine, trading
#   disabled. Set to a real chain id to go live — 11155111 for Ethereum Sepolia,
#   84532 for Base Sepolia (see CHAINS in packages/sdk/src/chain.ts for the full
#   list) — requires the three Secret Manager secrets to already exist
#   (verex-rpc-url-<DB_NAME>, verex-operator-key-<DB_NAME>,
#   verex-demo-mnemonic-<DB_NAME>); one command creates them:
#   ./scripts/setup-chain-secrets.sh test — see docs/runbooks/deploy.md.
#   deploy.sh only reads these, it never creates or prints them.
VEREX_CHAIN_ID=

# DEPLOY_TARGET — which committed backbone entry in packages/contracts/
#   deployments.json the seed uses: test or prod. Required whenever
#   VEREX_CHAIN_ID is set (deploy.sh refuses to run without it, so a prod
#   deploy can't silently seed against the test backbone or vice versa).
DEPLOY_TARGET=test
